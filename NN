# 2. 双重优化超参数调整器
# ----------------------
class DualOptimizationTuner:
    def __init__(self, initial_param_grid, target_metrics=None, max_iterations=10):
        self.param_grid = initial_param_grid
        self.current_iteration = 0
        self.max_iterations = max_iterations
        
        self.target_metrics = target_metrics or {
            'test_r2': 0.6,
            'min_test_r2': 0.3,
            'train_test_gap': 0.05,  # 更小的差距目标
            'min_train_r2': 0.4      # 训练集最低要求
        }
        
        self.history = []
        self.consecutive_improvements = 0
        self.stagnation_count = 0
        
    def adjust_params_based_on_performance(self, performance):
        train_r2 = performance['train_r2']
        test_r2 = performance['test_r2']
        train_test_gap = train_r2 - test_r2
        
        print(f"\n===== 双重优化分析 (迭代 {self.current_iteration + 1}) =====")
        print(f"当前性能: 训练集R²={train_r2:.4f}, 测试集R²={test_r2:.4f}, 差距={train_test_gap:.4f}")
        print(f"目标: 测试集R²≥{self.target_metrics['test_r2']}, 训练集R²≥{self.target_metrics['min_train_r2']}, 差距≤{self.target_metrics['train_test_gap']:.3f}")
        
        # 记录历史性能
        self.history.append({
            'iteration': self.current_iteration,
            'train_r2': train_r2,
            'test_r2': test_r2,
            'train_test_gap': train_test_gap,
            'params': self.param_grid.copy()
        })
        
        # 检查双重改进
        if len(self.history) > 1:
            prev_perf = self.history[-2]
            # 双重改进标准：训练集和测试集都改进
            train_improved = train_r2 > prev_perf['train_r2'] + 0.01
            test_improved = test_r2 > prev_perf['test_r2'] + 0.01
            
            if train_improved and test_improved:
                self.consecutive_improvements += 1
                self.stagnation_count = 0
                print("检测到双重改进！")
            elif not train_improved and not test_improved:
                self.stagnation_count += 1
                self.consecutive_improvements = 0
                print("性能停滞")
            else:
                self.stagnation_count += 1
                print("单方面改进")
        
        # 策略1: 训练集性能不足
        if train_r2 < self.target_metrics['min_train_r2']:
            print("提升训练集性能...")
            # 降低正则化
            if 'initial_alpha' in self.param_grid:
                current_alphas = self.param_grid['initial_alpha']
                new_alphas = [max(1e-7, x * 0.5) for x in current_alphas]
                self.param_grid['initial_alpha'] = new_alphas
            
            # 增大网络
            if 'hidden_layer_sizes' in self.param_grid:
                larger_layers = []
                for layer in self.param_grid['hidden_layer_sizes']:
                    if isinstance(layer, tuple):
                        larger = tuple(int(size * 1.4) for size in layer)
                        larger_layers.append(larger)
                self.param_grid['hidden_layer_sizes'] = list(set(larger_layers))
            
            # 降低dropout
            if 'dropout_rate' in self.param_grid:
                self.param_grid['dropout_rate'] = [max(0.05, x - 0.1) for x in self.param_grid['dropout_rate']]
        
        # 策略2: 测试集性能不足但训练集好
        elif test_r2 < self.target_metrics['min_test_r2'] and train_r2 > test_r2 + 0.1:
            print("减少过拟合，提升测试集性能...")
            # 适度增加正则化
            if 'initial_alpha' in self.param_grid:
                current_alphas = self.param_grid['initial_alpha']
                new_alphas = [x * 1.3 for x in current_alphas]
                self.param_grid['initial_alpha'] = new_alphas
            
            # 适度减小网络
            if 'hidden_layer_sizes' in self.param_grid:
                smaller_layers = []
                for layer in self.param_grid['hidden_layer_sizes']:
                    if isinstance(layer, tuple):
                        smaller = tuple(max(20, int(size * 0.8)) for size in layer)
                        smaller_layers.append(smaller)
                self.param_grid['hidden_layer_sizes'] = list(set(smaller_layers))
        
        # 策略3: 接近目标时的微调
        elif (test_r2 > self.target_metrics['test_r2'] * 0.8 and 
              train_test_gap < self.target_metrics['train_test_gap'] * 1.5):
            print("接近目标，进行精细调整...")
            # 轻微调整
            if 'initial_alpha' in self.param_grid:
                self.param_grid['initial_alpha'] = [x * 0.95 for x in self.param_grid['initial_alpha']]
            if 'initial_lr' in self.param_grid:
                self.param_grid['initial_lr'] = [min(0.01, x * 1.05) for x in self.param_grid['initial_lr']]
        
        # 约束参数范围
        self._constrain_param_ranges()
        
        self.current_iteration += 1
        return self.param_grid
    
    def _constrain_param_ranges(self):
        """约束超参数范围"""
        if 'initial_alpha' in self.param_grid:
            self.param_grid['initial_alpha'] = [max(1e-7, min(1e-2, x)) for x in self.param_grid['initial_alpha']]
        
        if 'hidden_layer_sizes' in self.param_grid:
            valid_layers = []
            for layer in self.param_grid['hidden_layer_sizes']:
                if isinstance(layer, tuple) and len(layer) >= 2 and all(size >= 15 for size in layer):
                    valid_layers.append(layer)
            self.param_grid['hidden_layer_sizes'] = list(set(valid_layers)) or [(40, 20), (50, 25)]
        
        if 'dropout_rate' in self.param_grid:
            self.param_grid['dropout_rate'] = [max(0.05, min(0.5, x)) for x in self.param_grid['dropout_rate']]
        
        if 'initial_lr' in self.param_grid:
            self.param_grid['initial_lr'] = [max(1e-5, min(0.01, x)) for x in self.param_grid['initial_lr']]
    
    def should_continue(self):
        """判断是否继续优化"""
        if self.current_iteration >= self.max_iterations:
            print(f"\n达到最大迭代次数 ({self.max_iterations})")
            return False
        if not self.history:
            return True
        
        last = self.history[-1]
        
        # 双重达标检查
        train_ok = last['train_r2'] >= self.target_metrics['min_train_r2']
        test_ok = last['test_r2'] >= self.target_metrics['min_test_r2']
        gap_ok = last['train_test_gap'] <= self.target_metrics['train_test_gap'] * 1.5
        
        if train_ok and test_ok and gap_ok:
            print(f"\n达到双重优化目标！")
            return False
        if self.stagnation_count >= 3:
            print(f"\n连续3次迭代无双重改进")
            return False
        return True

