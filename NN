# 1. 双重优化MLP回归器 - 同时优化训练集和测试集性能
# ----------------------
class DualOptimizedMLPRegressor(BaseEstimator, RegressorMixin):
    def __init__(self, initial_alpha=5e-4, initial_lr=0.001,  
                 hidden_layer_sizes=(40, 20), activation='relu',  
                 max_iter=20000, random_state=None, lr_decay_factor=0.5,  
                 alpha_increase_factor=1.5, patience=5, dropout_rate=0.4,
                 solver='lbfgs', tol=1e-6):
        self.initial_alpha = initial_alpha
        self.initial_lr = initial_lr
        self.hidden_layer_sizes = hidden_layer_sizes
        self.activation = activation
        self.max_iter = max_iter
        self.random_state = random_state
        self.lr_decay_factor = lr_decay_factor
        self.alpha_increase_factor = alpha_increase_factor
        self.patience = patience
        self.dropout_rate = dropout_rate
        self.solver = solver
        self.tol = tol
        self.model = None
        self.alpha = initial_alpha
        self.learning_rate_init = initial_lr
        self.X_val = None
        self.y_val = None
        
    def fit(self, X, y):
        # 使用较小的验证集，保留更多训练数据
        X_train, X_val, y_train, y_val = train_test_split(
            X, y, test_size=0.2, random_state=self.random_state
        )
        self.X_val = X_val
        self.y_val = y_val
        
        # 平衡的模型配置，避免过拟合同时保持训练性能
        self.model = MLPRegressor(
            hidden_layer_sizes=self.hidden_layer_sizes,
            activation=self.activation,
            solver=self.solver,
            alpha=self.alpha,
            learning_rate_init=self.learning_rate_init,
            max_iter=300,
            early_stopping=True,
            validation_fraction=0.1,
            n_iter_no_change=20,
            random_state=self.random_state,
            warm_start=True,
            tol=self.tol,
            learning_rate='adaptive' if self.solver == 'adam' else 'constant'
        )
        
        # 初始训练
        self.model.fit(X_train, y_train)
        pred_val = self.model.predict(X_val)
        best_val_loss = mse(y_val, pred_val)
        current_patience = 0
        iterations_since_update = 0
        best_model_weights = None
        
        # 动态训练循环 - 平衡策略
        total_iterations = int(self.max_iter / 300)
        for i in range(1, total_iterations):
            # 温和的dropout策略
            if self.dropout_rate > 0 and np.random.random() < 0.5:
                mask = np.random.binomial(1, 1 - self.dropout_rate, size=X_train.shape)
                X_train_dropout = X_train * mask
            else:
                X_train_dropout = X_train
                
            self.model.fit(X_train_dropout, y_train)
            
            # 计算验证损失
            pred_val = self.model.predict(X_val)
            current_val_loss = mse(y_val, pred_val)
            
            # 保存最佳模型权重
            if current_val_loss < best_val_loss:
                best_val_loss = current_val_loss
                best_model_weights = [w.copy() for w in self.model.coefs_] + [b.copy() for b in self.model.intercepts_]
                current_patience = 0
                iterations_since_update = 0
            else:
                current_patience += 1
                iterations_since_update += 1
                
                # 温和的调整策略
                if self.solver == 'adam' and current_patience >= self.patience + 2:
                    self.learning_rate_init *= self.lr_decay_factor
                    self.model.learning_rate_init = self.learning_rate_init
                    current_patience = 0
                
                if iterations_since_update >= 12:
                    self.alpha *= self.alpha_increase_factor
                    self.model.alpha = self.alpha
                    iterations_since_update = 6
        
        # 恢复最佳模型权重
        if best_model_weights is not None:
            self.model.coefs_ = [w.copy() for w in best_model_weights[:len(self.model.coefs_)]]
            self.model.intercepts_ = [b.copy() for b in best_model_weights[len(self.model.coefs_):]]
        
        # 最终微调 - 轻微的正则化
        self.model.warm_start = False
        self.model.max_iter = 200
        self.model.alpha = self.alpha * 1.3
        self.model.fit(X, y)
        return self
    
    def predict(self, X):
        return self.model.predict(X)
    
    def get_params(self, deep=True):
        return {
            'initial_alpha': self.initial_alpha,
            'initial_lr': self.initial_lr,
            'hidden_layer_sizes': self.hidden_layer_sizes,
            'activation': self.activation,
            'max_iter': self.max_iter,
            'random_state': self.random_state,
            'lr_decay_factor': self.lr_decay_factor,
            'alpha_increase_factor': self.alpha_increase_factor,
            'patience': self.patience,
            'dropout_rate': self.dropout_rate,
            'solver': self.solver,
            'tol': self.tol
        }
    
    def set_params(self, **params):
        for param, value in params.items():
            setattr(self, param, value)
        return self

