# 3. 辅助函数 - 双重优化评分
# ----------------------
def calculate_metrics(model, X_train, X_test, y_train, y_test):
    """计算完整的评估指标"""
    pred_train = model.predict(X_train)
    pred_test = model.predict(X_test)
    train_mae = mean_absolute_error(y_train, pred_train)
    test_mae = mean_absolute_error(y_test, pred_test)
    train_rmse = np.sqrt(mean_squared_error(y_train, pred_train))
    test_rmse = np.sqrt(mean_squared_error(y_test, pred_test))
    train_r2 = r2_score(y_train, pred_train)
    test_r2 = r2_score(y_test, pred_test)
    return train_mae, test_mae, train_rmse, test_rmse, train_r2, test_r2

def calculate_dual_score(train_r2, test_r2, train_rmse, test_rmse):
    """
    计算双重优化分数
    目标：训练集和测试集R²同时最大，RMSE同时最小
    """
    # R²部分：训练集和测试集同等重要
    r2_score_dual = (train_r2 + test_r2) * 0.5
    
    # RMSE部分：训练集和测试集同等重要（取倒数，因为RMSE越小越好）
    rmse_score_dual = (1 / (1 + train_rmse) + 1 / (1 + test_rmse)) * 0.5
    
    # 一致性奖励：训练集和测试集性能接近
    r2_consistency = 1.0 - abs(train_r2 - test_r2)
    rmse_consistency = 1.0 - abs(train_rmse - test_rmse) * 0.5
    
    consistency_bonus = (r2_consistency + rmse_consistency) * 0.5
    
    dual_score = r2_score_dual + rmse_score_dual + consistency_bonus
    return dual_score

def save_class_definition(class_obj, filename, output_dir):
    """将自定义类的定义保存到文件"""
    class_source = inspect.getsource(class_obj)
    file_path = os.path.join(output_dir, filename)
    
    with open(file_path, 'w', encoding='utf-8') as f:
        f.write('"""\n')
        f.write('双重优化神经网络回归器类定义\n')
        f.write('此文件由训练代码自动生成，用于预测时加载模型\n')
        f.write('"""\n\n')
        f.write('import numpy as np\n')
        f.write('from sklearn.neural_network import MLPRegressor\n')
        f.write('from sklearn.model_selection import train_test_split\n')
        f.write('from sklearn.base import BaseEstimator, RegressorMixin\n')
        f.write('from sklearn.metrics import mean_squared_error as mse\n')
        f.write('import warnings\n')
        f.write('warnings.filterwarnings(\'ignore\')\n\n')
        f.write(class_source)
    
    print(f"✅ 自定义类定义已保存至: {file_path}")
    return file_path

def find_dual_optimized_model(results_all_states):
    """
    寻找训练集和测试集同时达到最优的双重优化模型
    标准：训练集和测试集R²同时最大，RMSE同时最小
    """
    print("\n正在寻找训练集和测试集同时最优的双重优化模型...")
    
    # 计算每个模型的双重优化分数
    dual_scores = {}
    performance_details = {}
    
    for state, result in results_all_states.items():
        train_r2 = result['train_r2']
        test_r2 = result['test_r2']
        train_rmse = result['train_rmse']
        test_rmse = result['test_rmse']
        
        # 计算双重优化分数
        dual_score = calculate_dual_score(train_r2, test_r2, train_rmse, test_rmse)
        dual_scores[state] = dual_score
        
        # 存储性能详情
        performance_details[state] = {
            'train_r2': train_r2,
            'test_r2': test_r2,
            'train_rmse': train_rmse,
            'test_rmse': test_rmse,
            'r2_gap': abs(train_r2 - test_r2),
            'rmse_gap': abs(train_rmse - test_rmse),
            'dual_score': dual_score
        }
        
        print(f"随机状态 {state}: 双重分数 = {dual_score:.4f} "
              f"(训练R²={train_r2:.4f}, 测试R²={test_r2:.4f}, "
              f"训练RMSE={train_rmse:.4f}, 测试RMSE={test_rmse:.4f})")
    
    # 找到双重分数最高的模型
    best_dual_state = max(dual_scores, key=dual_scores.get)
    best_dual_score = dual_scores[best_dual_state]
    
    print(f"\n🎯 找到双重优化模型: 随机状态 {best_dual_state}")
    print(f"   双重分数: {best_dual_score:.4f}")
    print(f"   训练集 R²: {performance_details[best_dual_state]['train_r2']:.4f}, RMSE: {performance_details[best_dual_state]['train_rmse']:.4f}")
    print(f"   测试集 R²: {performance_details[best_dual_state]['test_r2']:.4f}, RMSE: {performance_details[best_dual_state]['test_rmse']:.4f}")
    print(f"   R²差距: {performance_details[best_dual_state]['r2_gap']:.4f}, RMSE差距: {performance_details[best_dual_state]['rmse_gap']:.4f}")
    
    return best_dual_state

